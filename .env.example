# ── Core ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local PostgreSQL started by `npm run dev` (embedded-postgres). Point this at
# any PostgreSQL 14+ instance (Neon, Supabase, RDS…) and set EMBEDDED_POSTGRES=false.
DATABASE_URL=postgresql://loupe:loupe@localhost:55432/loupe
EMBEDDED_POSTGRES=true

# ── Auth (NextAuth / Auth.js v5) ─────────────────────────────────────────────
AUTH_SECRET=replace-with-openssl-rand-base64-33
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# ── Field-level encryption for tax IDs / bank details (32 bytes, base64) ─────
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# ── Payments (Stripe Connect). Leave blank to run in demo-payment mode. ──────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Use Stripe Tax for tax calculation (otherwise the built-in estimator is used)
STRIPE_TAX_ENABLED=false

# ── File storage. Leave S3 blank to store uploads on local disk in dev. ─────
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Live data providers (optional) ───────────────────────────────────────────
METALS_API_KEY=
FX_API_KEY=

# ── Scheduled jobs (/api/cron/*) ─────────────────────────────────────────────
CRON_SECRET=replace-with-random-string
