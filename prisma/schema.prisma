// ─────────────────────────────────────────────────────────────────────────────
//  Loupe — multi-vendor marketplace for fine, luxury & handcrafted jewelry
//  PostgreSQL · Prisma ORM 7
//
//  Conventions
//  • Money is stored as BigInt *minor units* (cents, paise, pence) next to an
//    ISO-4217 `currency` column. INT4 caps at ~$21M / ₹2.1 crore, which is not
//    enough headroom for high jewelry, so every monetary column is INT8.
//  • Physical measurements (mm, grams, carats, ring sizes) are Float.
//    Financial *rates* (FX, spot metal) are Decimal for auditability.
//  • Orders snapshot everything they depend on (addresses, prices, titles,
//    FX + metal rates) so historical records never change when listings do.
//  • A buyer checkout (`Order`) fans out into one `SellerOrder` per vendor.
//    Fulfilment, commission, payouts, returns and disputes live on the
//    SellerOrder because every vendor ships, and is paid, independently.
//  • Fields marked "denormalised" are maintained by the service layer to keep
//    catalogue filtering and sorting on indexed columns.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

