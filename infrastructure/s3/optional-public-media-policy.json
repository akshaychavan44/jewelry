{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicImagesOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::REPLACE_MEDIA_BUCKET/product-media/*",
        "arn:aws:s3:::REPLACE_MEDIA_BUCKET/store-branding/*",
        "arn:aws:s3:::REPLACE_MEDIA_BUCKET/review-media/*"
      ]
    }
  ]
}
