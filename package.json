{
  "name": "loupe-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loupe — a multi-vendor marketplace for fine, luxury and handcrafted jewelry.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/db.mjs start",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db.mjs run -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/db.mjs run -- prisma db seed",
    "db:reset": "node scripts/db.mjs run -- prisma migrate reset --force",
    "db:studio": "node scripts/db.mjs run -- prisma studio",
    "setup": "node scripts/db.mjs setup",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.4",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
