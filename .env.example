# ── Core ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email: password recovery and custom-enquiry alerts.
# Use a verified Resend sender; dashboard alerts work without these settings.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Neon Serverless PostgreSQL connection string
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_placeholder@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Auth (NextAuth / Auth.js v5) ─────────────────────────────────────────────
AUTH_SECRET=replace-with-openssl-rand-base64-33
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# ── Field-level encryption for tax IDs / bank details (32 bytes, base64) ─────
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# ── Payments (Stripe Connect). Leave blank to run in demo-payment mode. ──────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Use Stripe Tax for tax calculation (otherwise the built-in estimator is used)
STRIPE_TAX_ENABLED=false

# ── File storage. UploadThing is preferred; local disk is development-only. ─────
# Preferred storage: create an app at uploadthing.com and copy its server token.
# A paid UploadThing plan is required for private verification images.
# Set the default ACL to private and enable per-request ACL overrides.
UPLOADTHING_TOKEN=
# Optional legacy S3 provider (used only when UPLOADTHING_TOKEN is blank).
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Optional for Cloudflare R2 / S3-compatible storage. For R2 use S3_REGION=auto.
S3_ENDPOINT=
# Cloud uploads are mandatory on Vercel and in production. Public and private
# bucket names must differ; only the public media prefixes may allow public reads.

# ── Live data providers (optional) ───────────────────────────────────────────
METALS_API_KEY=
FX_API_KEY=

# ── Scheduled jobs (/api/cron/*) ─────────────────────────────────────────────
CRON_SECRET=replace-with-random-string
